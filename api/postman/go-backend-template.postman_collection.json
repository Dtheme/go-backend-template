{
  "info": {
    "name": "go-backend-template",
    "description": "本地 API 验证集合。导入 Postman 后设置 baseUrl（默认 http://localhost:8080），先 make run 再逐个发送。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "noteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "健康检查",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "v1",
      "item": [
        {
          "name": "GET /v1/ping",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('message pong', () => pm.expect(pm.response.json().message).to.eql('pong'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/ping (405)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 405', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "notes（1.0.0）",
      "item": [
        {
          "name": "POST /v1/notes 创建笔记",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/notes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"买菜\", \"content\": \"鸡蛋、牛奶\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('id format', () => pm.expect(b.id).to.match(/^n_[0-9a-f]{12}$/));",
                  "pm.test('fields', () => { pm.expect(b.title).to.eql('买菜'); pm.expect(b.content).to.eql('鸡蛋、牛奶'); pm.expect(b.created_at).to.be.a('string'); });",
                  "pm.collectionVariables.set('noteId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/notes/{id} 读取笔记",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/notes/{{noteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('same id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('noteId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/notes/{id} 不存在 (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/notes/n_000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/notes title 为空 (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/notes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"   \"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('invalid_argument'));",
                  "pm.test('message names field', () => pm.expect(pm.response.json().error.message).to.include('title'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
