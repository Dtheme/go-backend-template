{
  "permissions": {
    "allow": [
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(make:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(bash:*)",
      "Bash(lsof:*)",
      "Bash(shasum:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-format.sh"
          }
        ]
      }
    ]
  }
}
